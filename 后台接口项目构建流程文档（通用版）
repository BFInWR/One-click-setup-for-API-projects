/**
 * XXX 控制器
 *
 * <p>功能说明：提供 XXX 相关的 RESTful API 接口</p>
 * <p>接口路径：/api/v1/xxx</p>
 *
 * @author developer
 */
@RestController
@RequestMapping("/api/v1/xxx")
public class XxxController {

    private static final Logger log = LoggerFactory.getLogger(XxxController.class);

    private final XxxService xxxService;
    private final ObjectMapper objectMapper;

    @Autowired
    public XxxController(XxxService xxxService, ObjectMapper objectMapper) {
        this.xxxService = xxxService;
        this.objectMapper = objectMapper;
    }

    /**
     * 单条数据同步接口
     *
     * <p>接口路径：POST /api/v1/xxx/sync</p>
     * <p>功能说明：同步单条 XXX 数据到本地数据库</p>
     *
     * @param originalJson 原始 JSON 入参
     * @return 统一响应格式
     */
    @PostMapping("/sync")
    public Result<Map<String, Object>> sync(@RequestBody String originalJson) {
        try {
            String trimmedJson = originalJson.trim();
            if (trimmedJson.startsWith("[")) {
                return Result.fail(400, "请求格式错误：当前接口仅支持单条数据同步，请使用 /api/v1/xxx/syncBatch");
            }

            Xxx savedXxx = xxxService.upsertXxx(parseDetails(originalJson));

            Map<String, Object> data = Map.of(
                    "bizId", savedXxx.getBizId(),
                    "status", savedXxx.getStatus()
            );
            return Result.success(data);
        } catch (Exception e) {
            log.error("同步数据失败", e);
            return Result.fail("同步失败：" + e.getMessage());
        }
    }

    /**
     * 批量数据同步接口
     *
     * <p>接口路径：POST /api/v1/xxx/syncBatch</p>
     * <p>功能说明：批量同步 XXX 数据，每条数据独立处理</p>
     *
     * @param dataList 数据列表
     * @return 统一响应格式
     */
    @PostMapping("/syncBatch")
    public Result<Map<String, Object>> syncBatch(@RequestBody List<Map<String, Object>> dataList) {
        try {
            int successCount = 0;
            int failCount = 0;

            for (Map<String, Object> dataMap : dataList) {
                try {
                    String jsonStr = objectMapper.writeValueAsString(dataMap);
                    xxxService.upsertXxx(parseDetails(jsonStr));
                    successCount++;
                } catch (Exception e) {
                    log.warn("批量同步单条失败: {}", e.getMessage());
                    failCount++;
                }
            }

            Map<String, Object> data = Map.of(
                    "totalCount", dataList.size(),
                    "successCount", successCount,
                    "failCount", failCount
            );
            return Result.success(data);
        } catch (Exception e) {
            log.error("批量同步失败", e);
            return Result.fail("批量同步失败：" + e.getMessage());
        }
    }

    /**
     * 解析明细数据
     *
     * @param jsonStr JSON 字符串
     * @return 实体对象
     * @throws Exception 解析失败时抛出异常
     */
    private Xxx parseDetails(String jsonStr) throws Exception {
        Xxx xxx = objectMapper.readValue(jsonStr, Xxx.class);
        xxx.setOriginalJson(jsonStr);
        return xxx;
    }

    /**
     * 根据业务 ID 查询
     *
     * <p>接口路径：GET /api/v1/xxx/{bizId}</p>
     *
     * @param bizId 业务 ID
     * @return 统一响应格式
     */
    @GetMapping("/{bizId}")
    public Result<Xxx> getByBizId(@PathVariable String bizId) {
        Xxx xxx = xxxService.getByBizId(bizId);
        if (xxx != null) {
            return Result.success(xxx);
        }
        return Result.fail(404, "数据不存在");
    }

    /**
     * 根据业务 ID 删除
     *
     * <p>接口路径：DELETE /api/v1/xxx/{bizId}</p>
     *
     * @param bizId 业务 ID
     * @return 统一响应格式
     */
    @DeleteMapping("/{bizId}")
    public Result<Void> deleteByBizId(@PathVariable String bizId) {
        boolean deleted = xxxService.deleteByBizId(bizId);
        if (deleted) {
            return Result.success("删除成功", null);
        }
        return Result.fail(404, "数据不存在或删除失败");
