package com.example.xxx.util;

import okhttp3.*;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import java.io.IOException;
import java.util.Map;
import java.util.concurrent.TimeUnit;

/**
 * OkHttp 工具类
 *
 * <p>功能说明：封装 OkHttp 常用操作，支持链式调用</p>
 *
 * @author developer
 */
public class OkHttpUtils {

    private static final Logger log = LoggerFactory.getLogger(OkHttpUtils.class);

    private static final MediaType JSON_TYPE = MediaType.parse("application/json; charset=utf-8");

    private static final OkHttpClient CLIENT = new OkHttpClient.Builder()
            .connectTimeout(30, TimeUnit.SECONDS)
            .readTimeout(30, TimeUnit.SECONDS)
            .writeTimeout(30, TimeUnit.SECONDS)
            .build();

    private String url;
    private Map<String, String> headerMap;
    private String body;

    private OkHttpUtils() {
    }

    public static OkHttpUtils builder() {
        return new OkHttpUtils();
    }

    public OkHttpUtils url(String url) {
        this.url = url;
        return this;
    }

    public OkHttpUtils addHeader(Map<String, String> headerMap) {
        this.headerMap = headerMap;
        return this;
    }

    public OkHttpUtils addBody(String body) {
        this.body = body;
        return this;
    }

    /**
     * POST JSON 请求
     */
    public OkHttpUtils jsonPost() {
        return this;
    }

    /**
     * 同步执行请求
     */
    public String sync() throws IOException {
        Request.Builder requestBuilder = new Request.Builder().url(url);

        if (headerMap != null) {
            headerMap.forEach(requestBuilder::addHeader);
        }

        RequestBody requestBody = body != null ? RequestBody.create(body, JSON_TYPE) : null;
        requestBuilder.post(requestBody);

        try (Response response = CLIENT.newCall(requestBuilder.build()).execute()) {
            if (!response.isSuccessful()) {
                throw new IOException("请求失败, code=" + response.code());
            }
            ResponseBody resBody = response.body();
            return resBody != null ? resBody.string() : "";
        }
    }

    /**
     * GET 请求
     */
    public String get() throws IOException {
        Request.Builder requestBuilder = new Request.Builder().url(url);

        if (headerMap != null) {
            headerMap.forEach(requestBuilder::addHeader);
        }

        requestBuilder.get();

        try (Response response = CLIENT.newCall(requestBuilder.build()).execute()) {
            if (!response.isSuccessful()) {
                throw new IOException("请求失败, code=" + response.code());
            }
            ResponseBody resBody = response.body();
            return resBody != null ? resBody.string() : "";
        }
    }
}
