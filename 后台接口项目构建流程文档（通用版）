```java
package com.example.xxx.service;

import com.alibaba.fastjson.JSONObject;
import com.example.xxx.util.OkHttpUtils;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;
import java.io.IOException;
import java.util.HashMap;
import java.util.Map;
import java.util.Optional;

/**
 * 第三方 API 客户端
 *
 * <p>功能说明：</p>
 * <ul>
 *   <li>封装调用第三方平台接口的 HTTP 请求</li>
 *   <li>支持 Mock 模式用于本地测试</li>
 *   <li>统一日志记录</li>
 * </ul>
 *
 * @author developer
 */
@Component
public class XxxApiClient {

    private static final Logger log = LoggerFactory.getLogger(XxxApiClient.class);

    private final XxxConfig config;
    private final XxxMockService mockService;

    @Autowired
    public XxxApiClient(XxxConfig config, XxxMockService mockService) {
        this.config = config;
        this.mockService = mockService;
    }

    /**
     * 调用第三方接口示例
     *
     * @param params 请求参数
     * @return 接口响应结果
     */
    public JSONObject doSomething(JSONObject params) {
        long startTime = System.currentTimeMillis();

        if (config.isMockEnabled()) {
            log.info("[MOCK] doSomething, params={}", params);
            return mockService.mockDoSomething();
        }

        String url = config.getBaseUrl() + "/api/xxx/doSomething";
        try {
            JSONObject requestBody = buildRequestBody(params);
            Map<String, String> headerMap = buildRequestHeader();

            String response = OkHttpUtils.builder()
                    .url(url)
                    .addHeader(headerMap)
                    .addBody(requestBody.toJSONString())
                    .jsonPost()
                    .sync();

            long elapsed = System.currentTimeMillis() - startTime;
            log.info("doSomething, url={}, elapsed={}ms, response={}", url, elapsed, response);

            return parseResponse(response);
        } catch (IOException e) {
            log.error("调用第三方接口失败, url={}", url, e);
            return getErrorResponse("调用失败: " + e.getMessage());
        }
    }

    /**
     * 构建请求体
     *
     * <p>说明：根据 encType 配置决定是否加密数据</p>
     */
    private JSONObject buildRequestBody(JSONObject params) {
        JSONObject requestBody = new JSONObject();
        String encType = Optional.ofNullable(config.getEncType()).orElse("").trim();

        if (encType.isEmpty()) {
            requestBody.put("data", params);
            requestBody.put("encType", "");
        } else if ("SM2".equalsIgnoreCase(encType)) {
            try {
                String encryptedData = SM2Encryptor.encrypt(params.toJSONString(), config.getAppSecret());
                String sign = SM2Encryptor.sign(params.toJSONString(), config.getAppSecret());
                requestBody.put("data", encryptedData);
                requestBody.put("sign", sign);
                requestBody.put("encType", "SM2");
            } catch (Exception e) {
                log.error("SM2加密失败", e);
                throw new RuntimeException("SM2加密失败: " + e.getMessage());
            }
        } else if ("AES".equalsIgnoreCase(encType)) {
            try {
                String encryptedData = AESUtil.encrypt(params.toJSONString(), config.getAppSecret());
                requestBody.put("data", encryptedData);
                requestBody.put("encType", "AES");
            } catch (Exception e) {
                log.error("AES加密失败", e);
                throw new RuntimeException("AES加密失败: " + e.getMessage());
            }
        } else {
            throw new RuntimeException("不支持的加密类型: " + encType);
        }

        return requestBody;
    }

    /**
     * 构建请求头
     */
    private Map<String, String> buildRequestHeader() {
        Map<String, String> headerMap = new HashMap<>();
        headerMap.put("Content-Type", "application/json; charset=utf-8");
        headerMap.put("appKey", config.getAppKey());
        return headerMap;
    }

    /**
     * 解析响应
     */
    private JSONObject parseResponse(String response) {
        try {
            return JSONObject.parseObject(response);
        } catch (Exception e) {
            log.error("响应解析失败: {}", response, e);
            JSONObject result = new JSONObject();
            result.put("code", "503");
            result.put("msg", "响应解析失败:" + e.getMessage());
            return result;
        }
    }

    /**
     * 构造错误响应
     */
    private JSONObject getErrorResponse(String errorMsg) {
        JSONObject result = new JSONObject();
        result.put("code", "500");
        result.put("msg", errorMsg);
        return result;
    }
}
