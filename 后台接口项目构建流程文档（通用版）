package com.example.xxx.service;

import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.example.xxx.common.context.UserContext;
import com.example.xxx.mapper.XxxDetailMapper;
import com.example.xxx.mapper.XxxMapper;
import com.example.xxx.model.entity.Xxx;
import com.example.xxx.model.entity.XxxDetail;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.time.LocalDateTime;
import java.util.List;

/**
 * XXX 业务服务类
 *
 * <p>功能说明：处理 XXX 相关的业务逻辑</p>
 *
 * @author developer
 */
@Service
public class XxxService {

    private static final Logger log = LoggerFactory.getLogger(XxxService.class);

    @Autowired
    private XxxMapper xxxMapper;

    @Autowired
    private XxxDetailMapper xxxDetailMapper;

    /**
     * 保存数据
     *
     * <p>说明：新增数据，设置审计字段</p>
     *
     * @param xxx 实体对象
     * @return 保存后的实体对象
     */
    @Transactional(rollbackFor = Throwable.class)
    public Xxx saveXxx(Xxx xxx) {
        LocalDateTime now = LocalDateTime.now();
        String currentUser = UserContext.getUserId();

        xxx.setCreateTime(now);
        xxx.setUpdateTime(now);
        xxx.setCreateBy(currentUser);
        xxx.setUpdateBy(currentUser);
        xxx.setStatus("SYNCED");

        xxxMapper.insert(xxx);

        if (xxx.getDetails() != null && !xxx.getDetails().isEmpty()) {
            for (XxxDetail detail : xxx.getDetails()) {
                detail.setBizId(xxx.getBizId());
                detail.setCreateTime(now);
                detail.setUpdateTime(now);
                xxxDetailMapper.insert(detail);
            }
        }

        return xxx;
    }

    /**
     * 更新数据（Upsert 模式）
     *
     * <p>说明：存在则更新，不存在则插入</p>
     * <p>策略：根据 bizId 判断数据是否存在</p>
     *
     * @param xxx 实体对象
     * @return 更新后的实体对象
     */
    @Transactional(rollbackFor = Throwable.class)
    public Xxx upsertXxx(Xxx xxx) {
        LocalDateTime now = LocalDateTime.now();
        String currentUser = UserContext.getUserId();

        Xxx existingXxx = xxxMapper.findByBizId(xxx.getBizId());

        xxx.setUpdateTime(now);
        xxx.setUpdateBy(currentUser);

        if (existingXxx != null) {
            xxx.setId(existingXxx.getId());
            xxx.setCreateTime(existingXxx.getCreateTime());
            xxx.setCreateBy(existingXxx.getCreateBy());
            if (xxx.getStatus() == null || xxx.getStatus().trim().isEmpty()) {
                xxx.setStatus("SYNCED");
            }
            xxxMapper.updateById(xxx);

            QueryWrapper<XxxDetail> deleteWrapper = new QueryWrapper<>();
            deleteWrapper.eq("biz_id", xxx.getBizId());
            xxxDetailMapper.delete(deleteWrapper);
        } else {
            xxx.setCreateTime(now);
            xxx.setCreateBy(currentUser);
            if (xxx.getStatus() == null || xxx.getStatus().trim().isEmpty()) {
                xxx.setStatus("SYNCED");
            }
            xxxMapper.insert(xxx);
        }

        if (xxx.getDetails() != null && !xxx.getDetails().isEmpty()) {
            for (XxxDetail detail : xxx.getDetails()) {
                detail.setBizId(xxx.getBizId());
                detail.setCreateTime(now);
                detail.setUpdateTime(now);
                xxxDetailMapper.insert(detail);
            }
        }

        return xxx;
    }

    /**
     * 根据业务 ID 查询
     *
     * @param bizId 业务 ID
     * @return 实体对象，不存在则返回 null
     */
    public Xxx getByBizId(String bizId) {
        return xxxMapper.findByBizId(bizId);
    }

    /**
     * 删除数据（级联删除明细）
     *
     * @param bizId 业务 ID
     * @return true-删除成功，false-删除失败
     */
    @Transactional(rollbackFor = Throwable.class)
    public boolean deleteByBizId(String bizId) {
        try {
            QueryWrapper<XxxDetail> detailWrapper = new QueryWrapper<>();
            detailWrapper.eq("biz_id", bizId);
            xxxDetailMapper.delete(detailWrapper);

            QueryWrapper<Xxx> wrapper = new QueryWrapper<>();
            wrapper.eq("biz_id", bizId);
            int count = xxxMapper.delete(wrapper);

            return count > 0;
        } catch (Exception e) {
            log.error("删除数据失败, bizId={}", bizId, e);
            return false;
        }
    }

    /**
     * 批量删除
     *
     * <p>说明：统一事务，全部成功或全部回滚</p>
     *
     * @param bizIds 业务 ID 列表
     * @return 删除的数量
     */
    @Transactional(rollbackFor = Throwable.class)
    public int batchDelete(List<String> bizIds) {
        QueryWrapper<XxxDetail> detailWrapper = new QueryWrapper<>();
        detailWrapper.in("biz_id", bizIds);
        xxxDetailMapper.delete(detailWrapper);

        QueryWrapper<Xxx> wrapper = new QueryWrapper<>();
        wrapper.in("biz_id", bizIds);
        return xxxMapper.delete(wrapper);
    }

    /**
     * 按时间范围查询
     *
     * @param startTime 开始时间
     * @param endTime   结束时间
     * @return 实体列表，按创建时间倒序排列
     */
    public List<Xxx> getByTimeRange(LocalDateTime startTime, LocalDateTime endTime) {
        QueryWrapper<Xxx> wrapper = new QueryWrapper<>();
        if (startTime != null) {
            wrapper.ge("create_time", startTime);
        }
        if (endTime != null) {
            wrapper.le("create_time", endTime);
        }
        wrapper.orderByDesc("create_time");
        return xxxMapper.selectList(wrapper);
    }
}
```

### 9.2 Service 开发最佳实践

